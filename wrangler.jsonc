{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stcc-election-2026-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": { "ALLOWED_ORIGINS": "https://erross.github.io,http://127.0.0.1:5173,http://localhost:5173" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "stcc-election-2026",
    "database_id": "00000000-0000-4000-8000-000000000000",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["0 * * * *"] }
}
