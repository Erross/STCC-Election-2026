{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stcc-election-2026-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://erross.github.io,http://127.0.0.1:5173,http://localhost:5173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stcc-election-2026",
      "database_id": "7f234ff9-55d2-43ab-9592-3b9a03be3958",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "account_id": "e8ec876664df92bfde2c8edb6320d370"
}
